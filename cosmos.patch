+    @staticmethod
+    def _load_lora_over_dcp(
+        state_dict: dict[str, Any],
+        storage_reader: FileSystemReader,
+        adapter_path: Path,
+    ) -> None:
+        from safetensors.torch import load_file
+
+        adapter_path = Path(adapter_path)
+        adapter_state = load_file(str(adapter_path), device="cpu")
+        expected_keys = {key for key in state_dict if "lora_" in key}
+        actual_keys = set(adapter_state)
+        if actual_keys != expected_keys:
+            missing = sorted(expected_keys - actual_keys)
+            unexpected = sorted(actual_keys - expected_keys)
+            raise ValueError(
+                f"LoRA adapter keys do not match the configured model: "
+                f"missing={missing[:8]}, unexpected={unexpected[:8]}"
+            )
+
+        base_state = {key: value for key, value in state_dict.items() if key not in expected_keys}
+        dcp.load(state_dict=base_state, storage_reader=storage_reader)
+
+        with torch.no_grad():
+            for key in sorted(expected_keys):
+                target = state_dict[key]
+                if hasattr(target, "to_local"):
+                    target = target.to_local()
+                source = adapter_state[key]
+                if tuple(source.shape) != tuple(target.shape):
+                    raise ValueError(
+                        f"LoRA tensor shape mismatch for {key}: adapter={tuple(source.shape)}, "
+                        f"model={tuple(target.shape)}"
+                    )
+                target.copy_(source.to(device=target.device, dtype=target.dtype))
+
