+    def save_model_only_for_eval(self, model: ImaginaireModel, iteration: int) -> None:
+        """Save only model weights for inference/eval without updating resume metadata."""
+        if self.async_mode == AsyncMode.ASYNC_WITH_PINNED_MEM:
+            self._wait_for_previous_async_checkpoint()
+
+        checkpoint_file = f"iter_{iteration:09}"
+        output_dirname = os.path.join(self.save_dirname, checkpoint_file, "model")
+        storage_writer = self.get_storage_writer(output_dirname)
+        save_planner = CustomSavePlanner(
+            dedup_save_to_lowest_rank=True,
+            enable_plan_caching=True,
+            cache_plans_key="custom_planner_eval_model",
+        )
+
+        start_time = time.monotonic()
+        dcp.save(
+            ModelWrapper(model).state_dict(),
+            storage_writer=storage_writer,
+            planner=save_planner,
+        )
+        elapsed_time = time.monotonic() - start_time
+        log.info(
+            f"Saved model-only eval checkpoint to {os.path.join(self.save_dirname, checkpoint_file)} "
+            f"in {elapsed_time:.2f} seconds"
+        )
+
